  speaker: {fileID: 0}
  messageText: "\u041E\u043D\u0430 \u043D\u0430\u0447\u0430\u043B\u0430 \u0447\u0438\u0442\u0430\u0442\u044C
    \u043D\u043E\u0442\u0430\u0446\u0438\u0438 \u0441 \u0443\u0434\u0432\u043E\u0435\u043D\u043D\u043E\u0439
    \u0441\u0438\u043B\u043E\u0439. \u0421\u043B\u0430\u0432\u0430 \u0431\u043E\u0433\u0443,
    \u044D\u0442\u043E \u043F\u0440\u0438\u0434\u0435\u0442\u0441\u044F \u0441\u043B\u0443\u0448\u0430\u0442\u044C
    \u0443\u0436\u0435 \u043D\u0435 \u043C\u043D\u0435, \u0430 \u043A\u043E\u043C\u0443-\u0442\u043E
    \u0434\u0440\u0443\u0433\u043E\u043C\u0443. \u042F \u0441\u0445\u0432\u0430\u0442\u0438\u043B
    \u043A\u0443\u0440\u0442\u043A\u0443, \u0440\u044E\u043A\u0437\u0430\u043A \u0438
    \u043A\u0440\u0438\u043A\u043D\u0443\u043B \u0432 \u0434\u0430\u043B\u0435\u043A\u0443\u044E
    \u0433\u043E\u0441\u0442\u0438\u043D\u0443\u044E \u0438\u0437 \u043A\u043E\u0440\u0438\u0434\u043E\u0440\u0430."
