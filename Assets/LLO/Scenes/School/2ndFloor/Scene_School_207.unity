  speaker: {fileID: 0}
  messageText: "<i>\u0420\u0430\u043D\u044C\u0448\u0435 \u043E\u043D \u043F\u0440\u043E\u0441\u0442\u043E
    \u043C\u043E\u0434\u0435\u043B\u044C\u044E \u0441\u043A\u0435\u043B\u0435\u0442\u0430,
    \u043D\u043E \u043F\u043E\u0442\u043E\u043C \u043A\u0442\u043E-\u0442\u043E \u043F\u043E\u0432\u0435\u0441\u0438\u043B
    \u043D\u0430 \u043D\u0435\u0433\u043E \u0431\u0435\u043B\u044B\u0439 \u0433\u0430\u043B\u0441\u0442\u0443\u043A
    \u0438 \u043B\u044E\u0434\u0438 \u0441\u0442\u0430\u043B\u0438 \u043E\u0442\u043D\u043E\u0441\u0438\u0442\u0441\u044F
    \u043A \u043D\u0435\u043C\u0443 \u043F\u043E \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E\u043C\u0443. "
  lineID: -1
