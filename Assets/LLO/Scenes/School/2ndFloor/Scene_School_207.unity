  speaker: {fileID: 0}
  messageText: "\u042F \u043D\u0435 \u043E\u0447\u0435\u043D\u044C \u0432\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044C\u043D\u043E
    \u0435\u0451 \u0441\u043B\u0443\u0448\u0430\u043B. \u0415\u0441\u043B\u0438 \u043C\u0430\u043C\u0430
