  speaker: {fileID: 0}
  messageText: "<i>\u0412\u043D\u0435\u0437\u0430\u043F\u043D\u043E, \u043A\u0440\u044B\u0441\u043A\u0430
    \u0440\u0435\u0437\u043A\u043E \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0430\u0441\u044C.
