  playerID: -1
  speaker: {fileID: 0}
  messageText: "\u0418\u0448\u044C \u0442\u044B, \u043D\u0430 \u0432\u0441\u0435
    \u0443 \u0442\u0435\u0431\u044F \u043E\u0442\u0433\u043E\u0432\u043E\u0440\u043A\u0430.
    \u042F \u0435\u043C\u0443 \u0441\u043B\u043E\u0432\u043E, \u043E\u043D \u043C\u043D\u0435
    \u0434\u0435\u0441\u044F\u0442\u044C! \u041D\u0430\u0448\u0435\u043B \u043C\u043E\u043C\u0435\u043D\u0442,
    \u043A\u043E\u0433\u0434\u0430 \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C
    \u043F\u0440\u043E \u0431\u0430\u0442\u0430\u0440\u0435\u0439\u043A\u0438. \u0412\u043E\u0442
    \u0441\u043A\u0430\u0437\u0430\u043B \u0431\u044B \u0442\u044B \u0432 \u043D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u043E\u0435
    \u0432\u0440\u0435\u043C\u044F, \u044F \u0431\u044B \u0443\u0436\u0435 \u0434\u0430\u0432\u043D\u043E\u2026"
