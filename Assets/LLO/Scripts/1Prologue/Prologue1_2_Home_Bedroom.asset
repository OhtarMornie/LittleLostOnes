  speaker: {fileID: 0}
  messageText: " \u2026\u0438 \u0432\u043E\u043E\u0431\u0449\u0435, \u0432 8-\u043E\u043C
    \u043A\u043B\u0430\u0441\u0441\u0435 \u0443\u0436\u0435! \u041C\u043E\u0436\u0435\u0448\u044C
    \u0438 \u0441\u0430\u043C \u043F\u0440\u043E\u0441\u044B\u043F\u0430\u0442\u044C\u0441\u044F.
    \u0411\u0443\u0434\u0438\u043B\u044C\u043D\u0438\u043A \u0442\u0435\u0431\u0435
    \u043D\u0430 \u0447\u0442\u043E? \u0423 \u0442\u0435\u0431\u044F \u043E\u043D
    \u0434\u0430\u0436\u0435 \u0432 \u0442\u0435\u043B\u0435\u0444\u043E\u043D\u0435
    \u0435\u0441\u0442\u044C, \u0437\u0430\u0447\u0435\u043C \u0442\u0435\u0445\u043D\u0438\u043A\u0443
    \u0442\u0430\u043A\u0443\u044E \u043D\u0430\u0432\u043E\u0440\u043E\u0447\u0435\u043D\u043D\u0443\u044E
