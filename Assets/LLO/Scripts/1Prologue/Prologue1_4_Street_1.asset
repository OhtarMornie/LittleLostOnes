  speaker: {fileID: 0}
  messageText: "\u041D\u0435 \u0443\u0441\u043F\u0435\u043B \u044F \u0443\u0431\u0435\u0436\u0430\u0442\u044C
    \u043E\u0442 \u0441\u0432\u043E\u0435\u0439 \u043C\u0430\u043C\u044B, \u0442\u0430\u043A
    \u0432\u043D\u043E\u0432\u044C \u043C\u043D\u0435 \u043F\u0440\u0435\u0434\u0441\u0442\u043E\u0438\u0442
