  speaker: {fileID: 0}
  messageText: "\u041D\u0435 \u0434\u0443\u043C\u0430\u043B, \u0447\u0442\u043E \u044F
    \u0442\u0430\u043A \u0434\u043E\u043B\u0433\u043E \u0438  \u0443\u043F\u043E\u0440\u043D\u043E
