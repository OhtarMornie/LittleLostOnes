  messageText: " \u0414\u0430 \u043B\u0430\u0434\u043D\u043E \u0432\u0430\u043C,
    \u0443\u0441\u043F\u043E\u043A\u043E\u0439\u0442\u0435\u0441\u044C \u0443\u0436\u0435.
    \u041D\u0435\u0443\u0436\u0435\u043B\u0438 \u0432\u044B \u043D\u0435 \u043C\u043E\u0436\u0435\u0442\u0435
    \u0441\u043E\u0439\u0442\u0438\u0441\u044C \u043D\u0430 \u0442\u043E\u043C, \u0447\u0442\u043E
    \u0432\u0430\u043C \u043F\u0440\u043E\u0441\u0442\u043E \u043D\u0440\u0430\u0432\u044F\u0442\u0441\u044F
    \u0440\u0430\u0437\u043D\u044B\u0435 \u0432\u0435\u0449\u0438? \u041A\u0430\u043A
    \u0434\u0435\u0442\u0438 \u043C\u0430\u043B\u044B\u0435 \u0441\u043F\u043E\u0440\u0438\u0442\u0435
    \u0438\u0437-\u0437\u0430 \u043C\u0443\u043B\u044C\u0442\u0438\u043A\u043E\u0432."
