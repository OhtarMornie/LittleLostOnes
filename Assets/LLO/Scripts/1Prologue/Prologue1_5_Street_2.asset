  messageText: " \u042F \u0441\u0440\u0430\u0437\u0443 \u0441\u043A\u0430\u0437\u0430\u043B,
    \u0447\u0442\u043E \u0432\u0441\u0435 \u0441 \u0442\u043E\u0431\u043E\u0439 \u0445\u043E\u0440\u043E\u0448\u043E,
    \u0438 \u0442\u044B \u043D\u0430\u0432\u0435\u0440\u043D\u044F\u043A\u0430 \u0441\u043D\u043E\u0432\u0430
    \u043D\u0430 \u0441\u0432\u043E\u0438 \u043C\u0443\u043B\u044C\u0442\u0438\u043A\u0438
    \u043F\u0440\u043E \u0433\u043E\u0432\u043E\u0440\u044F\u0449\u0443\u044E \u0441\u043E\u0431\u0430\u043A\u0443
    \u0437\u0430\u0441\u043C\u043E\u0442\u0440\u0435\u043B\u0441\u044F."
