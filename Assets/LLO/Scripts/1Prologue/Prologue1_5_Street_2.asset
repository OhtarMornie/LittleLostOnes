  speaker: {fileID: 3503659167585205392, guid: d55d6cb06dfd54b479189462d0b17a5d, type: 3}
  messageText: "\u0422\u044B \u0441\u0430\u043C \u0442\u043E\u043B\u044C\u043A\u043E
    \u0447\u0442\u043E \u0437\u0430\u0449\u0438\u0449\u0430\u043B \u0441\u0432\u043E\u0438\u0445
    \xAB\u0440\u0430\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u0435\u0439\xBB,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043F\u0440\u043E\u0441\u0442\u043E
    \u043A\u0430\u0442\u0430\u044E\u0442\u0441\u044F \u0432 \u0441\u0442\u0440\u0435\u043C\u043D\u043E\u043C
    \u0444\u0443\u0440\u0433\u043E\u043D\u0447\u0438\u043A\u0435 \u0443 \u0447\u0435\u0440\u0442\u0430
    \u043D\u0430 \u0440\u043E\u0433\u0430\u0445, \u0434\u0430 \u0441\u0440\u044B\u0432\u0430\u044E\u0442
    \u043C\u0430\u0441\u043A\u0438. "
  lineID: -1
  multiLineIDs: 
  isBackground: 0
  noAnimation: 0
  headClip: {fileID: 0}
  mouthClip: {fileID: 0}
