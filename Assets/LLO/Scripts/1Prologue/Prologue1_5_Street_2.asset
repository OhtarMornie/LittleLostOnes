    \u0438 \u043C\u043E\u0438\u043C\u0438 \u0441\u043B\u043E\u0432\u0430\u043C\u0438,
    \u0438 \u0441\u0435\u0433\u043E\u0434\u043D\u044F\u0448\u043D\u0438\u043C \u0445\u043E\u043B\u043E\u0434\u043D\u044B\u043C
    \u0443\u0442\u0440\u043E\u043C. \u041D\u0430\u0434\u043E \u0441\u0440\u043E\u0447\u043D\u043E
    \u043F\u0435\u0440\u0435\u0432\u043E\u0434\u0438\u0442\u044C \u0442\u0435\u043C\u0443."
